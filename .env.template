# Aptixar Integration API endpoint.
APTIXAR_BASE_URL=https://api.aptixar.com

# Personal Access Token from the Aptixar web portal:
#   https://aptixar.com  -> Settings -> Integrations
# Format: aptx_int_<32 chars>. Shown once at creation -- store securely.
APTIXAR_TOKEN=aptx_int_replace_me

# Optional. Parent folder ID for uploaded assets. Leave blank to upload to tenant root.
APTIXAR_PARENT_FOLDER_ID=
